      <aliases enabled='yes' />
      <column caption='Cancelled orders percentage' datatype='real' name='[Calculation_0513523380162561]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD(IF [order_status] = &quot;Cancelled&quot; THEN [order_id] END)/ COUNTD([order_id])' />
      </column>
      <column caption='Cancelled orders' datatype='integer' name='[Calculation_0513523385204739]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [order_status] = &quot;Cancelled&quot; THEN 1 ELSE 0 END)' />
      </column>
      <column caption='Completed orders' datatype='integer' name='[Calculation_0513523441737732]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [order_status] = &quot;Completed&quot; THEN 1 ELSE 0 END)' />
      </column>
      <column caption='count orders' datatype='integer' name='[Calculation_0513524099252229]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([order_id])' />
      </column>
      <column caption='Average preparation time' datatype='real' name='[Calculation_0513524099973126]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='Avg([preparation_time])' />
      </column>
      <column caption='month' datatype='integer' datatype-customized='true' name='[Calculation_0513524103852039]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='MONTH([order_date])' />
      </column>
      <column caption='day' datatype='integer' datatype-customized='true' name='[Calculation_0513524115410953]' role='dimension' type='quantitative'>
        <calculation class='tableau' formula='DAY([order_date])' />
      </column>
      <column caption='revenue' datatype='real' name='[Calculation_0513524422987786]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if([order_status]) = &apos;Completed&apos; then ([price])end' />
